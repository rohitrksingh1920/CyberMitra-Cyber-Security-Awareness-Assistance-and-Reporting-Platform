# Copy this file to .env (docker-compose reads the root .env instead when using docker,
# this file is mainly for running the backend standalone / locally).

ENV=production
DATABASE_URL=postgresql+psycopg2://cybermitra:CHANGE_ME@db:5432/cybermitra
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ADMIN_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
RATE_LIMIT_DEFAULT=60/minute
