# Copy this to .env in the project root before running `docker compose up`.
# `docker compose` automatically reads a file named .env in this directory.

# --- Postgres ---
POSTGRES_USER=cybermitra
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cybermitra

# --- Backend ---
# Comma-separated list of origins allowed to call the API. Use your real
# domain(s) here. Since the frontend and API are served from the same
# domain via the nginx proxy, this mainly matters if you ever call the API
# from a different origin.
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ADMIN_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
RATE_LIMIT_DEFAULT=60/minute
